{
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "printWidth": 120,
    "bracketSpacing": true,
    "arrowParens": "always",
    "bracketSameLine": false,
    "objectWrap": "collapse",
    "overrides": [
        {
            "files": ["src/assets/lessons/**/*.json"],
            "options": {
                "plugins": ["prettier-plugin-sort-json"],
                "jsonRecursiveSort": true
            }
        }
    ]
}
